{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#151426",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "one.guppyguide.cawsocial",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "extra": {
      "warning": "Community app, not operated by the official CAW team.",
      "eas": {
        "projectId": "b94174e0-cf59-4910-b81b-7e2ffa168e11"
      }
    },
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "one.guppyguide.cawsocial",
      "supportsTablet": false
    },
    "name": "CAW Social",
    "orientation": "portrait",
    "owner": "guppy9180s-team",
    "plugins": [
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use biometrics to unlock CAW Social."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "CAW Social uses a picture you choose as your profile picture, stored only on this phone."
        }
      ]
    ],
    "scheme": "cawsocial",
    "slug": "caw-social-app",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#151426"
    },
    "userInterfaceStyle": "light",
    "version": "0.3.3",
    "web": {
      "favicon": "./assets/icon.png"
    }
  }
}
